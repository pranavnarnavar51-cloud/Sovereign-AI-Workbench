{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SovereignAuditLogEvent",
  "type": "object",
  "required": ["timestamp", "event_id", "session_id", "clearance_tier", "action_type", "tamper_hmac_sha256"],
  "properties": {
    "timestamp": {"type": "string", "format": "date-time"},
    "event_id": {"type": "string"},
    "session_id": {"type": "string"},
    "user_identity": {"type": "string"},
    "clearance_tier": {"type": "string", "enum": ["SECRET_LEVEL_5", "SECRET_LEVEL_4", "RESTRICTED_LEVEL_2"]},
    "action_type": {"type": "string", "enum": ["PROMPT_INSPECTION", "TOOL_INVOCATION", "HITL_APPROVAL", "AIRGAP_BREACH_ATTEMPT"]},
    "agent_involved": {"type": "string"},
    "details": {"type": "object"},
    "tamper_hmac_sha256": {"type": "string"}
  }
}
